#!/bin/bash
# 头像打印机 macOS 启动器。
# 解析项目目录（.app 的上级目录，即存放 launch.py 的文件夹），补全 PATH 后运行 launch.py。
set -e
APP_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$APP_DIR"

# Finder 启动时 PATH 很精简，这里补上 Homebrew / 用户目录里常见的 node/python 位置。
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$HOME/.volta/bin:$HOME/.asdf/shims:$PATH"

PY="$(command -v python3 || true)"
[ -z "$PY" ] && PY="/usr/bin/python3"

# 若缺少 python3，给出可见提示（.app 无终端窗口时写到日志并弹窗）。
if [ ! -x "$PY" ]; then
  /usr/bin/osascript -e 'display alert "头像打印机启动失败" message "未找到 Python 3，请先安装（https://www.python.org 或 brew install python3）。"'
  exit 1
fi

exec "$PY" "$APP_DIR/launch.py"
